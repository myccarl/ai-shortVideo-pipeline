# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=please-change-to-a-strong-password-16chars-min
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_INTERNAL_ENDPOINT=http://minio:9000
MINIO_PUBLIC_BUCKET=ai-platform-public
MINIO_PRIVATE_BUCKET=ai-platform-private

# LLM providers
DEEPSEEK_API_KEY=
QWEN_API_KEY=
GLM_API_KEY=

# Kling video provider
KLING_BASE_URL=https://api-beijing.klingai.com
KLING_ACCESS_KEY=
KLING_SECRET_KEY=
KLING_VIDEO_MODEL=kling-v2-5-turbo

# Visual provider selection.
# Keep the default Kling backend, or set either value to atlascloud. The video
# backend also accepts muapi.
VISUAL_IMAGE_PROVIDER=kling
VISUAL_VIDEO_PROVIDER=kling

# Atlas Cloud Media API provider
ATLASCLOUD_API_KEY=
ATLASCLOUD_MEDIA_BASE_URL=https://api.atlascloud.ai/api/v1
ATLASCLOUD_IMAGE_MODEL=bytedance/seedream-v5.0-lite
ATLASCLOUD_VIDEO_MODEL=bytedance/seedance-2.0-fast/image-to-video
ATLASCLOUD_VIDEO_RESOLUTION=720p
ATLASCLOUD_VIDEO_GENERATE_AUDIO=true

# MuAPI Seedance 2 image-to-video backend (optional)
MUAPI_API_KEY=
MUAPI_BASE_URL=https://api.muapi.ai/api/v1
MUAPI_VIDEO_MODEL=seedance-2-image-to-video-fast

# Langfuse observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=false

# D41-B CLIP consistency warning (keyframe prompt-image scoring)
CLIP_CONSISTENCY_ENABLED=true
CLIP_CONSISTENCY_THRESHOLD=0.22

# D41-C AV sync rescue (attempt to save generated video after hard drift)
AV_RESCUE_ENABLED=true
AV_RESCUE_TEMPO_MAX=1.30
AV_RESCUE_PAD_MAX_SEC=5.0
AV_RESCUE_REWRITE_MAX_DRIFT_SEC=15.0

# Gateway JWT secret (ISSUE-1 修复后必填，缺失或弱值时 compose / gateway 启动失败)
# 生成强随机：
#   openssl rand -base64 32
# 禁止使用包含 dev-only / please-override / change-me / do-not-use 的字串。
GATEWAY_AUTH_JWT_SECRET=
